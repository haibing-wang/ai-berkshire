# ===== 系统、环境与开发产物 =====
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# 编辑器与AI工具配置/缓存
.vscode/
.idea/
*.swp
*.swo
.codex/

# 临时目录（含雪球登录态缓存等本地状态）
/tmp/

# 日志产物（logs/ 目录结构由 logs/.gitignore 追踪保留）
logs/command-log.jsonl
logs/*.log
logs/*.jsonl

# ===== 音视频大文件不入库 =====
# 如确需提交某个文件，用 git add -f 显式加入
*.m4a
*.mp3
*.wav
*.mp4
*.mov

# ===== 公司品牌图：本地生成，不推送 =====
assets/公司品牌图/

# ===== 本地资料区：不打算公开的文件放这个目录，永不入库 =====
# API token（如 FinMind 的 local/finmind_token.txt）也放这里，只留本机
/local/

# ===== 密钥/凭证类文件，任何位置一律不入库 =====
.env
.env.*
*_token.txt
*.token
